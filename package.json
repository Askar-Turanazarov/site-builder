{
  "name": "site-builder",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "npm run build:export-css && next build",
    "start": "next start",
    "lint": "eslint",
    "postinstall": "prisma generate && npm run build:export-css",
    "db:seed": "tsx prisma/seed.ts",
    "art:generate": "tsx scripts/generate-template-art.ts",
    "db:media": "tsx scripts/seed-demo-media.ts",
    "build:export-css": "tailwindcss -i src/app/globals.css -o src/lib/export/assets/tailwind.generated.css --minify"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@prisma/adapter-better-sqlite3": "^7.10.0",
    "@prisma/client": "7.10.0",
    "@tiptap/extension-link": "^3.31.3",
    "@tiptap/pm": "^3.31.3",
    "@tiptap/react": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "@types/sanitize-html": "^2.16.1",
    "archiver": "^8.0.0",
    "bcryptjs": "^3.0.3",
    "jose": "^6.2.11",
    "nanoid": "^6.0.1",
    "next": "16.3.4",
    "prisma": "7.10.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sanitize-html": "^2.17.7",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "@tailwindcss/postcss": "^4",
    "@types/archiver": "^8.0.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5"
  },
  "allowScripts": {
    "@prisma/engines@7.10.0": true,
    "better-sqlite3@12.11.1": true,
    "esbuild@0.28.2": true,
    "prisma@7.10.0": true,
    "unrs-resolver@1.12.2": true,
    "@parcel/watcher@2.5.1": true
  }
}
